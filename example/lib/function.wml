<?xml version="1.0"?>
<wml>
<card id="P1" title="Print Report" device="prv" orientation="landscape">

<p align="center">12345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456</p>

<!--
  function.wml — WapForm 函數自我測試報表
  用途：對第十七章「函數完整參考」中列舉的每一個函數，
        以文件上的範例運算式與預期值逐一比對，驗證實際執行結果是否與文件相符。
  涵蓋範圍：200 組測試案例，橫跨字串、數學、日期與時間、條件、編碼與轉換、其他 六大分類。
-->

  <!-- 全域計數器初始化 -->
  <setvar name="t_total"   value="0"/>
  <setvar name="t_passed"  value="0"/>
  <setvar name="t_failed"  value="0"/>

  <table border="1" cellpadding="2" cellspacing="0" width="100%" align="center">
    <tr><td colspan="6" align="center"><big><b>WapForm 函數自我測試報表</b></big></td></tr>
    <tr><td colspan="6" align="center">測試產生時間：$(NOW)　共 363 項測試</td></tr>
    <tr bgcolor="#DDDDDD">
      <td><b>函數</b></td><td><b>測試運算式</b></td>
      <td><b>預期值</b></td><td><b>實際值</b></td><td width="300"><b>說明</b></td><td><b>結果</b></td>
    </tr>

    <!-- ===== 字串函數（44 項） ===== -->
    <setvar name="c_total" value="0"/>
    <setvar name="c_passed" value="0"/>
    <tr bgcolor="#EEEEEE"><td colspan="6"><b>字串函數</b></td></tr>

    <!-- test #1: STR -->
    <setvar name="t_total"   value="t_total+1"/>
    <setvar name="c_total"   value="c_total+1"/>
    <setvar name="a1"   value="STR(3.14)"/>
    <setvar name="e1" value="'3.14'"/>
    <setvar name="p1"     value="IF(a1=e1,1,0)"/>
    <setvar name="t_passed"  value="t_passed+p1"/>
    <setvar name="t_failed"  value="t_failed+(1-p1)"/>
    <setvar name="c_passed"  value="c_passed+p1"/>
    <tr bgcolor="$(IF(p1=1,'#FFFFFF','#FFD0D0'))">
      <td><code>STR</code></td>
      <td><code>STR(3.14)</code></td>
      <td>$(STR(e1))</td>
      <td>$(STR(a1))</td>
      <td>將數值轉換為字串。</td>
      <td>$(IF(p1=1,'Y','N'))</td>
    </tr>

    <!-- test #2: STR -->
    <setvar name="t_total"   value="t_total+1"/>
    <setvar name="c_total"   value="c_total+1"/>
    <setvar name="a2"   value="STR(100)"/>
    <setvar name="e2" value="'100'"/>
    <setvar name="p2"     value="IF(a2=e2,1,0)"/>
    <setvar name="t_passed"  value="t_passed+p2"/>
    <setvar name="t_failed"  value="t_failed+(1-p2)"/>
    <setvar name="c_passed"  value="c_passed+p2"/>
    <tr bgcolor="$(IF(p2=1,'#FFFFFF','#FFD0D0'))">
      <td><code>STR</code></td>
      <td><code>STR(100)</code></td>
      <td>$(STR(e2))</td>
      <td>$(STR(a2))</td>
      <td>將數值轉換為字串。</td>
      <td>$(IF(p2=1,'Y','N'))</td>
    </tr>

    <!-- test #3: MID -->
    <setvar name="t_total"   value="t_total+1"/>
    <setvar name="c_total"   value="c_total+1"/>
    <setvar name="a3"   value="MID('Wapform', 2, 3)"/>
    <setvar name="e3" value="'apf'"/>
    <setvar name="p3"     value="IF(a3=e3,1,0)"/>
    <setvar name="t_passed"  value="t_passed+p3"/>
    <setvar name="t_failed"  value="t_failed+(1-p3)"/>
    <setvar name="c_passed"  value="c_passed+p3"/>
    <tr bgcolor="$(IF(p3=1,'#FFFFFF','#FFD0D0'))">
      <td><code>MID</code></td>
      <td><code>MID('Wapform', 2, 3)</code></td>
      <td>$(STR(e3))</td>
      <td>$(STR(a3))</td>
      <td>從字串 s 的第 start 個字元（1-based）取 len 個字元（以 byte 計）。</td>
      <td>$(IF(p3=1,'Y','N'))</td>
    </tr>

    <!-- test #4: LEN -->
    <setvar name="t_total"   value="t_total+1"/>
    <setvar name="c_total"   value="c_total+1"/>
    <setvar name="a4"   value="LEN('Hello')"/>
    <setvar name="e4" value="5"/>
    <setvar name="p4"     value="IF(a4=e4,1,0)"/>
    <setvar name="t_passed"  value="t_passed+p4"/>
    <setvar name="t_failed"  value="t_failed+(1-p4)"/>
    <setvar name="c_passed"  value="c_passed+p4"/>
    <tr bgcolor="$(IF(p4=1,'#FFFFFF','#FFD0D0'))">
      <td><code>LEN</code></td>
      <td><code>LEN('Hello')</code></td>
      <td>$(STR(e4))</td>
      <td>$(STR(a4))</td>
      <td>回傳字串的 UTF-8 字元數。</td>
      <td>$(IF(p4=1,'Y','N'))</td>
    </tr>

    <!-- test #5: LEN -->
    <setvar name="t_total"   value="t_total+1"/>
    <setvar name="c_total"   value="c_total+1"/>
    <setvar name="a5"   value="LEN('')"/>
    <setvar name="e5" value="0"/>
    <setvar name="p5"     value="IF(a5=e5,1,0)"/>
    <setvar name="t_passed"  value="t_passed+p5"/>
    <setvar name="t_failed"  value="t_failed+(1-p5)"/>
    <setvar name="c_passed"  value="c_passed+p5"/>
    <tr bgcolor="$(IF(p5=1,'#FFFFFF','#FFD0D0'))">
      <td><code>LEN</code></td>
      <td><code>LEN('')</code></td>
      <td>$(STR(e5))</td>
      <td>$(STR(a5))</td>
      <td>回傳字串的 UTF-8 字元數。</td>
      <td>$(IF(p5=1,'Y','N'))</td>
    </tr>

    <!-- test #6: REPLACE -->
    <setvar name="t_total"   value="t_total+1"/>
    <setvar name="c_total"   value="c_total+1"/>
    <setvar name="a6"   value="REPLACE('hello', 'l', 'm')"/>
    <setvar name="e6" value="'hemmo'"/>
    <setvar name="p6"     value="IF(a6=e6,1,0)"/>
    <setvar name="t_passed"  value="t_passed+p6"/>
    <setvar name="t_failed"  value="t_failed+(1-p6)"/>
    <setvar name="c_passed"  value="c_passed+p6"/>
    <tr bgcolor="$(IF(p6=1,'#FFFFFF','#FFD0D0'))">
      <td><code>REPLACE</code></td>
      <td><code>REPLACE('hello', 'l', 'm')</code></td>
      <td>$(STR(e6))</td>
      <td>$(STR(a6))</td>
      <td>將字串 s 中所有出現的 old 子字串取代為 new。</td>
      <td>$(IF(p6=1,'Y','N'))</td>
    </tr>

    <!-- test #7: REPT -->
    <setvar name="t_total"   value="t_total+1"/>
    <setvar name="c_total"   value="c_total+1"/>
    <setvar name="a7"   value="REPT('*', 5)"/>
    <setvar name="e7" value="'*****'"/>
    <setvar name="p7"     value="IF(a7=e7,1,0)"/>
    <setvar name="t_passed"  value="t_passed+p7"/>
    <setvar name="t_failed"  value="t_failed+(1-p7)"/>
    <setvar name="c_passed"  value="c_passed+p7"/>
    <tr bgcolor="$(IF(p7=1,'#FFFFFF','#FFD0D0'))">
      <td><code>REPT</code></td>
      <td><code>REPT('*', 5)</code></td>
      <td>$(STR(e7))</td>
      <td>$(STR(a7))</td>
      <td>將字串 s 重複 n 次後串接。</td>
      <td>$(IF(p7=1,'Y','N'))</td>
    </tr>

    <!-- test #8: REPT -->
    <setvar name="t_total"   value="t_total+1"/>
    <setvar name="c_total"   value="c_total+1"/>
    <setvar name="a8"   value="REPT('-', 20)"/>
    <setvar name="e8" value="'--------------------'"/>
    <setvar name="p8"     value="IF(a8=e8,1,0)"/>
    <setvar name="t_passed"  value="t_passed+p8"/>
    <setvar name="t_failed"  value="t_failed+(1-p8)"/>
    <setvar name="c_passed"  value="c_passed+p8"/>
    <tr bgcolor="$(IF(p8=1,'#FFFFFF','#FFD0D0'))">
      <td><code>REPT</code></td>
      <td><code>REPT('-', 20)</code></td>
      <td>$(STR(e8))</td>
      <td>$(STR(a8))</td>
      <td>將字串 s 重複 n 次後串接。</td>
      <td>$(IF(p8=1,'Y','N'))</td>
    </tr>

    <!-- test #9: MD5 -->
    <setvar name="t_total"   value="t_total+1"/>
    <setvar name="c_total"   value="c_total+1"/>
    <setvar name="a9"   value="MD5('Wapform')"/>
    <setvar name="e9" value="'A2269E58A973F7C621427BCC8BD3BBBA'"/>
    <setvar name="p9"     value="IF(a9=e9,1,0)"/>
    <setvar name="t_passed"  value="t_passed+p9"/>
    <setvar name="t_failed"  value="t_failed+(1-p9)"/>
    <setvar name="c_passed"  value="c_passed+p9"/>
    <tr bgcolor="$(IF(p9=1,'#FFFFFF','#FFD0D0'))">
      <td><code>MD5</code></td>
      <td><code>MD5('Wapform')</code></td>
      <td colspan="2">$(STR(a9))</td>
      <td>回傳字串 s 的 MD5 雜湊值（32 位十六進位字串），常用於密碼儲存與驗證。</td>
      <td>$(IF(p9=1,'Y','N'))</td>
    </tr>

    <!-- test #10: LeftPad2 -->
    <setvar name="t_total"   value="t_total+1"/>
    <setvar name="c_total"   value="c_total+1"/>
    <setvar name="a10"   value="LeftPad2('5',3)"/>
    <setvar name="e10" value="'  5'"/>
    <setvar name="p10"     value="IF(a10=e10,1,0)"/>
    <setvar name="t_passed"  value="t_passed+p10"/>
    <setvar name="t_failed"  value="t_failed+(1-p10)"/>
    <setvar name="c_passed"  value="c_passed+p10"/>
    <tr bgcolor="$(IF(p10=1,'#FFFFFF','#FFD0D0'))">
      <td><code>LeftPad2</code></td>
      <td><code>LeftPad2('5',3)</code></td>
      <td>$(STR(e10))</td>
      <td>$(STR(a10))</td>
      <td>左側補空白至 len 寬。</td>
      <td>$(IF(p10=1,'Y','N'))</td>
    </tr>

    <!-- test #11: RightPad2 -->
    <setvar name="t_total"   value="t_total+1"/>
    <setvar name="c_total"   value="c_total+1"/>
    <setvar name="a11"   value="RightPad2('5',3)"/>
    <setvar name="e11" value="'5  '"/>
    <setvar name="p11"     value="IF(a11=e11,1,0)"/>
    <setvar name="t_passed"  value="t_passed+p11"/>
    <setvar name="t_failed"  value="t_failed+(1-p11)"/>
    <setvar name="c_passed"  value="c_passed+p11"/>
    <tr bgcolor="$(IF(p11=1,'#FFFFFF','#FFD0D0'))">
      <td><code>RightPad2</code></td>
      <td><code>RightPad2('5',3)</code></td>
      <td>$(STR(e11))</td>
      <td>$(STR(a11))</td>
      <td>右側補空白至 len 寬。</td>
      <td>$(IF(p11=1,'Y','N'))</td>
    </tr>

    <!-- test #12: CenterPad -->
    <setvar name="t_total"   value="t_total+1"/>
    <setvar name="c_total"   value="c_total+1"/>
    <setvar name="a12"   value="CenterPad('5',5)"/>
    <setvar name="e12" value="'  5  '"/>
    <setvar name="p12"     value="IF(a12=e12,1,0)"/>
    <setvar name="t_passed"  value="t_passed+p12"/>
    <setvar name="t_failed"  value="t_failed+(1-p12)"/>
    <setvar name="c_passed"  value="c_passed+p12"/>
    <tr bgcolor="$(IF(p12=1,'#FFFFFF','#FFD0D0'))">
      <td><code>CenterPad</code></td>
      <td><code>CenterPad('5',5)</code></td>
      <td>$(STR(e12))</td>
      <td>$(STR(a12))</td>
      <td>置中補空白至 len 寬。</td>
      <td>$(IF(p12=1,'Y','N'))</td>
    </tr>

    <!-- test #13: LeftPad -->
    <setvar name="t_total"   value="t_total+1"/>
    <setvar name="c_total"   value="c_total+1"/>
    <setvar name="a13"   value="LeftPad('5',3,'0')"/>
    <setvar name="e13" value="'005'"/>
    <setvar name="p13"     value="IF(a13=e13,1,0)"/>
    <setvar name="t_passed"  value="t_passed+p13"/>
    <setvar name="t_failed"  value="t_failed+(1-p13)"/>
    <setvar name="c_passed"  value="c_passed+p13"/>
    <tr bgcolor="$(IF(p13=1,'#FFFFFF','#FFD0D0'))">
      <td><code>LeftPad</code></td>
      <td><code>LeftPad('5',3,'0')</code></td>
      <td>$(STR(e13))</td>
      <td>$(STR(a13))</td>
      <td>左側補指定字元至 len 寬。</td>
      <td>$(IF(p13=1,'Y','N'))</td>
    </tr>

    <!-- test #14: RightPad -->
    <setvar name="t_total"   value="t_total+1"/>
    <setvar name="c_total"   value="c_total+1"/>
    <setvar name="a14"   value="RightPad('5',3,'0')"/>
    <setvar name="e14" value="'500'"/>
    <setvar name="p14"     value="IF(a14=e14,1,0)"/>
    <setvar name="t_passed"  value="t_passed+p14"/>
    <setvar name="t_failed"  value="t_failed+(1-p14)"/>
    <setvar name="c_passed"  value="c_passed+p14"/>
    <tr bgcolor="$(IF(p14=1,'#FFFFFF','#FFD0D0'))">
      <td><code>RightPad</code></td>
      <td><code>RightPad('5',3,'0')</code></td>
      <td>$(STR(e14))</td>
      <td>$(STR(a14))</td>
      <td>右側補指定字元至 len 寬。</td>
      <td>$(IF(p14=1,'Y','N'))</td>
    </tr>

    <!-- test #15: RepeatStr -->
    <setvar name="t_total"   value="t_total+1"/>
    <setvar name="c_total"   value="c_total+1"/>
    <setvar name="a15"   value="RepeatStr('ab',3)"/>
    <setvar name="e15" value="'ababab'"/>
    <setvar name="p15"     value="IF(a15=e15,1,0)"/>
    <setvar name="t_passed"  value="t_passed+p15"/>
    <setvar name="t_failed"  value="t_failed+(1-p15)"/>
    <setvar name="c_passed"  value="c_passed+p15"/>
    <tr bgcolor="$(IF(p15=1,'#FFFFFF','#FFD0D0'))">
      <td><code>RepeatStr</code></td>
      <td><code>RepeatStr('ab',3)</code></td>
      <td>$(STR(e15))</td>
      <td>$(STR(a15))</td>
      <td>重複字串 n 次。</td>
      <td>$(IF(p15=1,'Y','N'))</td>
    </tr>

    <!-- test #16: CountStrOccur -->
    <setvar name="t_total"   value="t_total+1"/>
    <setvar name="c_total"   value="c_total+1"/>
    <setvar name="a16"   value="CountStrOccur('a','banana')"/>
    <setvar name="e16" value="3"/>
    <setvar name="p16"     value="IF(a16=e16,1,0)"/>
    <setvar name="t_passed"  value="t_passed+p16"/>
    <setvar name="t_failed"  value="t_failed+(1-p16)"/>
    <setvar name="c_passed"  value="c_passed+p16"/>
    <tr bgcolor="$(IF(p16=1,'#FFFFFF','#FFD0D0'))">
      <td><code>CountStrOccur</code></td>
      <td><code>CountStrOccur('a','banana')</code></td>
      <td>$(STR(e16))</td>
      <td>$(STR(a16))</td>
      <td>計算子字串出現次數。</td>
      <td>$(IF(p16=1,'Y','N'))</td>
    </tr>

    <!-- test #17: StartsWithStr -->
    <setvar name="t_total"   value="t_total+1"/>
    <setvar name="c_total"   value="c_total+1"/>
    <setvar name="a17"   value="StartsWithStr('Hello','He')"/>
    <setvar name="e17" value="True"/>
    <setvar name="p17"     value="IF(a17=e17,1,0)"/>
    <setvar name="t_passed"  value="t_passed+p17"/>
    <setvar name="t_failed"  value="t_failed+(1-p17)"/>
    <setvar name="c_passed"  value="c_passed+p17"/>
    <tr bgcolor="$(IF(p17=1,'#FFFFFF','#FFD0D0'))">
      <td><code>StartsWithStr</code></td>
      <td><code>StartsWithStr('Hello','He')</code></td>
      <td>$(STR(e17))</td>
      <td>$(STR(a17))</td>
      <td>字串是否以 prefix 開頭。</td>
      <td>$(IF(p17=1,'Y','N'))</td>
    </tr>

    <!-- test #18: EndsWithStr -->
    <setvar name="t_total"   value="t_total+1"/>
    <setvar name="c_total"   value="c_total+1"/>
    <setvar name="a18"   value="EndsWithStr('Hello','lo')"/>
    <setvar name="e18" value="True"/>
    <setvar name="p18"     value="IF(a18=e18,1,0)"/>
    <setvar name="t_passed"  value="t_passed+p18"/>
    <setvar name="t_failed"  value="t_failed+(1-p18)"/>
    <setvar name="c_passed"  value="c_passed+p18"/>
    <tr bgcolor="$(IF(p18=1,'#FFFFFF','#FFD0D0'))">
      <td><code>EndsWithStr</code></td>
      <td><code>EndsWithStr('Hello','lo')</code></td>
      <td>$(STR(e18))</td>
      <td>$(STR(a18))</td>
      <td>字串是否以 suffix 結尾。</td>
      <td>$(IF(p18=1,'Y','N'))</td>
    </tr>

    <!-- test #19: ContainsStr2 -->
    <setvar name="t_total"   value="t_total+1"/>
    <setvar name="c_total"   value="c_total+1"/>
    <setvar name="a19"   value="ContainsStr2('Hello','ell')"/>
    <setvar name="e19" value="True"/>
    <setvar name="p19"     value="IF(a19=e19,1,0)"/>
    <setvar name="t_passed"  value="t_passed+p19"/>
    <setvar name="t_failed"  value="t_failed+(1-p19)"/>
    <setvar name="c_passed"  value="c_passed+p19"/>
    <tr bgcolor="$(IF(p19=1,'#FFFFFF','#FFD0D0'))">
      <td><code>ContainsStr2</code></td>
      <td><code>ContainsStr2('Hello','ell')</code></td>
      <td>$(STR(e19))</td>
      <td>$(STR(a19))</td>
      <td>字串是否包含子字串。</td>
      <td>$(IF(p19=1,'Y','N'))</td>
    </tr>

    <!-- test #20: SplitStr -->
    <setvar name="t_total"   value="t_total+1"/>
    <setvar name="c_total"   value="c_total+1"/>
    <setvar name="a20"   value="SplitStr('a,b,c',',',2)"/>
    <setvar name="e20" value="'b'"/>
    <setvar name="p20"     value="IF(a20=e20,1,0)"/>
    <setvar name="t_passed"  value="t_passed+p20"/>
    <setvar name="t_failed"  value="t_failed+(1-p20)"/>
    <setvar name="c_passed"  value="c_passed+p20"/>
    <tr bgcolor="$(IF(p20=1,'#FFFFFF','#FFD0D0'))">
      <td><code>SplitStr</code></td>
      <td><code>SplitStr('a,b,c',',',2)</code></td>
      <td>$(STR(e20))</td>
      <td>$(STR(a20))</td>
      <td>以 delim 分割字串，取第 n 個 token（1-based）。</td>
      <td>$(IF(p20=1,'Y','N'))</td>
    </tr>

    <!-- test #21: SplitCount -->
    <setvar name="t_total"   value="t_total+1"/>
    <setvar name="c_total"   value="c_total+1"/>
    <setvar name="a21"   value="SplitCount('a,b,c',',')"/>
    <setvar name="e21" value="3"/>
    <setvar name="p21"     value="IF(a21=e21,1,0)"/>
    <setvar name="t_passed"  value="t_passed+p21"/>
    <setvar name="t_failed"  value="t_failed+(1-p21)"/>
    <setvar name="c_passed"  value="c_passed+p21"/>
    <tr bgcolor="$(IF(p21=1,'#FFFFFF','#FFD0D0'))">
      <td><code>SplitCount</code></td>
      <td><code>SplitCount('a,b,c',',')</code></td>
      <td>$(STR(e21))</td>
      <td>$(STR(a21))</td>
      <td>以 delim 分割字串，計算 token 數。</td>
      <td>$(IF(p21=1,'Y','N'))</td>
    </tr>

    <!-- test #22: JoinStr -->
    <setvar name="t_total"   value="t_total+1"/>
    <setvar name="c_total"   value="c_total+1"/>
    <setvar name="a22"   value="JoinStr('A  B  C',' ')"/>
    <setvar name="e22" value="'A B C'"/>
    <setvar name="p22"     value="IF(a22=e22,1,0)"/>
    <setvar name="t_passed"  value="t_passed+p22"/>
    <setvar name="t_failed"  value="t_failed+(1-p22)"/>
    <setvar name="c_passed"  value="c_passed+p22"/>
    <tr bgcolor="$(IF(p22=1,'#FFFFFF','#FFD0D0'))">
      <td><code>JoinStr</code></td>
      <td><code>JoinStr('A  B  C',' ')</code></td>
      <td>$(STR(e22))</td>
      <td>$(STR(a22))</td>
      <td>將 str 中以空白分隔的多個詞（可能連續多個空白）重新以 delim 串接。例：JoinStr('A B C', ' ') → 'A B C'。</td>
      <td>$(IF(p22=1,'Y','N'))</td>
    </tr>

    <!-- test #23: TokenAt -->
    <setvar name="t_total"   value="t_total+1"/>
    <setvar name="c_total"   value="c_total+1"/>
    <setvar name="a23"   value="TokenAt('a-b-c','-',2)"/>
    <setvar name="e23" value="'b'"/>
