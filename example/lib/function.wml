    <setvar name="c_total"   value="c_total+1"/>
    <setvar name="n159"   value="NBSP"/>
    <setvar name="m159" value="'&amp;#160;'"/>
    <setvar name="q159"     value="IF(n159=m159,1,0)"/>
    <setvar name="t_passed"  value="t_passed+q159"/>
    <setvar name="t_failed"  value="t_failed+(1-q159)"/>
    <setvar name="c_passed"  value="c_passed+q159"/>
    <tr bgcolor="$(IF(q159=1,'#FFFFFF','#FFD0D0'))">
      <td><code>NBSP</code></td>
      <td><code>NBSP</code></td>
      <td>$(STR(m159))</td>
      <td>$(STR(n159))</td>
      <td>HTML 不斷行空白字元實體</td>
      <td>$(IF(q159=1,'Y','N'))</td>
    </tr>

    <!-- test #new160: ENCRYPT -->
    <setvar name="t_total"   value="t_total+1"/>
    <setvar name="c_total"   value="c_total+1"/>
    <setvar name="n160"   value="ENCRYPT('AB','key')"/>
    <setvar name="m160" value="'2A27'"/>
    <setvar name="q160"     value="IF(n160=m160,1,0)"/>
    <setvar name="t_passed"  value="t_passed+q160"/>
    <setvar name="t_failed"  value="t_failed+(1-q160)"/>
    <setvar name="c_passed"  value="c_passed+q160"/>
    <tr bgcolor="$(IF(q160=1,'#FFFFFF','#FFD0D0'))">
      <td><code>ENCRYPT</code></td>
      <td><code>ENCRYPT('AB','key')</code></td>
      <td>$(STR(m160))</td>
      <td>$(STR(n160))</td>
      <td>XOR 加密，回傳十六進位字串</td>
      <td>$(IF(q160=1,'Y','N'))</td>
    </tr>

    <!-- test #new161: DECRYPT -->
    <setvar name="t_total"   value="t_total+1"/>
    <setvar name="c_total"   value="c_total+1"/>
    <setvar name="n161"   value="DECRYPT('2A27','key')"/>
    <setvar name="m161" value="'AB'"/>
    <setvar name="q161"     value="IF(n161=m161,1,0)"/>
    <setvar name="t_passed"  value="t_passed+q161"/>
    <setvar name="t_failed"  value="t_failed+(1-q161)"/>
    <setvar name="c_passed"  value="c_passed+q161"/>
    <tr bgcolor="$(IF(q161=1,'#FFFFFF','#FFD0D0'))">
      <td><code>DECRYPT</code></td>
      <td><code>DECRYPT('2A27','key')</code></td>
      <td>$(STR(m161))</td>
      <td>$(STR(n161))</td>
      <td>XOR 解密（還原 ENCRYPT 的結果）</td>
      <td>$(IF(q161=1,'Y','N'))</td>
    </tr>

    <!-- test #new162: HashOf -->
    <setvar name="t_total"   value="t_total+1"/>
    <setvar name="c_total"   value="c_total+1"/>
    <setvar name="n162"   value="HashOf('Wapform')"/>
    <setvar name="m162" value="'17333661'"/>
    <setvar name="q162"     value="IF(n162=m162,1,0)"/>
    <setvar name="t_passed"  value="t_passed+q162"/>
    <setvar name="t_failed"  value="t_failed+(1-q162)"/>
    <setvar name="c_passed"  value="c_passed+q162"/>
    <tr bgcolor="$(IF(q162=1,'#FFFFFF','#FFD0D0'))">
      <td><code>HashOf</code></td>
      <td><code>HashOf('Wapform')</code></td>
      <td>$(STR(m162))</td>
      <td>$(STR(n162))</td>
      <td>DJB2 雜湊，回傳 8 碼十六進位字串</td>
      <td>$(IF(q162=1,'Y','N'))</td>
    </tr>

    <!-- test #new163: COUNT -->
    <setvar name="t_total"   value="t_total+1"/>
    <setvar name="c_total"   value="c_total+1"/>
    <setvar name="n163"   value="COUNT([1,2,3])"/>
    <setvar name="m163" value="3"/>
    <setvar name="q163"     value="IF(n163=m163,1,0)"/>
    <setvar name="t_passed"  value="t_passed+q163"/>
    <setvar name="t_failed"  value="t_failed+(1-q163)"/>
    <setvar name="c_passed"  value="c_passed+q163"/>
    <tr bgcolor="$(IF(q163=1,'#FFFFFF','#FFD0D0'))">
      <td><code>COUNT</code></td>
      <td><code>COUNT([1,2,3])</code></td>
      <td>$(STR(m163))</td>
      <td>$(STR(n163))</td>
      <td>陣列元素個數。?? 原始碼回傳 High(Values)（最大索引），比實際元素數少 1，已修正</td>
      <td>$(IF(q163=1,'Y','N'))</td>
    </tr>

    <!-- test #new164: HIGH -->
    <setvar name="t_total"   value="t_total+1"/>
    <setvar name="c_total"   value="c_total+1"/>
    <setvar name="n164"   value="HIGH([1,2,3])"/>
    <setvar name="m164" value="2"/>
    <setvar name="q164"     value="IF(n164=m164,1,0)"/>
    <setvar name="t_passed"  value="t_passed+q164"/>
    <setvar name="t_failed"  value="t_failed+(1-q164)"/>
    <setvar name="c_passed"  value="c_passed+q164"/>
    <tr bgcolor="$(IF(q164=1,'#FFFFFF','#FFD0D0'))">
      <td><code>HIGH</code></td>
      <td><code>HIGH([1,2,3])</code></td>
      <td>$(STR(m164))</td>
      <td>$(STR(n164))</td>
      <td>陣列的最大索引（0-based）</td>
      <td>$(IF(q164=1,'Y','N'))</td>
    </tr>

    <!-- test #new165: LOW -->
    <setvar name="t_total"   value="t_total+1"/>
    <setvar name="c_total"   value="c_total+1"/>
    <setvar name="n165"   value="LOW([1,2,3])"/>
    <setvar name="m165" value="0"/>
    <setvar name="q165"     value="IF(n165=m165,1,0)"/>
    <setvar name="t_passed"  value="t_passed+q165"/>
    <setvar name="t_failed"  value="t_failed+(1-q165)"/>
    <setvar name="c_passed"  value="c_passed+q165"/>
    <tr bgcolor="$(IF(q165=1,'#FFFFFF','#FFD0D0'))">
      <td><code>LOW</code></td>
      <td><code>LOW([1,2,3])</code></td>
      <td>$(STR(m165))</td>
      <td>$(STR(n165))</td>
      <td>陣列的最小索引（固定為 0）</td>
      <td>$(IF(q165=1,'Y','N'))</td>
    </tr>

    <!-- test #new166: VAR -->
    <setvar name="t_total"   value="t_total+1"/>
    <setvar name="c_total"   value="c_total+1"/>
    <setvar name="svar166" value="0"/>
    <setvar name="n166"   value="VAR('svar166',42)"/>
    <setvar name="m166" value="42"/>
    <setvar name="q166"     value="IF(n166=m166,1,0)"/>
    <setvar name="t_passed"  value="t_passed+q166"/>
    <setvar name="t_failed"  value="t_failed+(1-q166)"/>
    <setvar name="c_passed"  value="c_passed+q166"/>
    <tr bgcolor="$(IF(q166=1,'#FFFFFF','#FFD0D0'))">
      <td><code>VAR</code></td>
      <td><code>VAR('svar166',42)</code></td>
      <td>$(STR(m166))</td>
      <td>$(STR(n166))</td>
      <td>設定/讀取狀態變數（第一參數為變數名稱字串），常用於 Web 模板跨區塊動態新增變數，回傳設定後的值</td>
      <td>$(IF(q166=1,'Y','N'))</td>
    </tr>

    <!-- test #new167: INC -->
    <setvar name="t_total"   value="t_total+1"/>
    <setvar name="c_total"   value="c_total+1"/>
    <setvar name="svar167" value="10"/>
    <setvar name="n167"   value="INC('svar167',5)"/>
    <setvar name="m167" value="15"/>
    <setvar name="q167"     value="IF(n167=m167,1,0)"/>
    <setvar name="t_passed"  value="t_passed+q167"/>
    <setvar name="t_failed"  value="t_failed+(1-q167)"/>
    <setvar name="c_passed"  value="c_passed+q167"/>
    <tr bgcolor="$(IF(q167=1,'#FFFFFF','#FFD0D0'))">
      <td><code>INC</code></td>
      <td><code>INC('svar167',5)</code></td>
      <td>$(STR(m167))</td>
      <td>$(STR(n167))</td>
      <td>將指定名稱的狀態變數遞增 step 後回傳新值（第一參數為變數名稱字串）</td>
      <td>$(IF(q167=1,'Y','N'))</td>
    </tr>

    <!-- test #new168: DEC -->
    <setvar name="t_total"   value="t_total+1"/>
    <setvar name="c_total"   value="c_total+1"/>
    <setvar name="svar168" value="10"/>
    <setvar name="n168"   value="DEC('svar168',3)"/>
    <setvar name="m168" value="7"/>
    <setvar name="q168"     value="IF(n168=m168,1,0)"/>
    <setvar name="t_passed"  value="t_passed+q168"/>
    <setvar name="t_failed"  value="t_failed+(1-q168)"/>
    <setvar name="c_passed"  value="c_passed+q168"/>
    <tr bgcolor="$(IF(q168=1,'#FFFFFF','#FFD0D0'))">
      <td><code>DEC</code></td>
      <td><code>DEC('svar168',3)</code></td>
      <td>$(STR(m168))</td>
      <td>$(STR(n168))</td>
      <td>將指定名稱的狀態變數遞減 step 後回傳新值（第一參數為變數名稱字串）</td>
      <td>$(IF(q168=1,'Y','N'))</td>
    </tr>

    <tr bgcolor="#F5F5F5"><td colspan="6" align="right">
      其他函數 小計：$(c_passed) / $(c_total) 通過
    </td></tr>

  </table>

  <!-- ===== 總結 ===== -->
  <p>
    <b>測試總數：</b>$(t_total)　
    <b>通過：</b>$(t_passed)　
    <b>失敗：</b>$(t_failed)　
    <b>通過率：</b>$(FORMAT('%.1f',t_passed/t_total*100))%
  </p>

  <if cnd="t_failed&gt;0">
    <p style="color:red">
      <b>? 發現 $(t_failed) 項函數行為與文件不符，請檢查上表標示 ? 的列。</b>
    </p>
  </if>
  <if cnd="t_failed=0">
    <p style="color:green">
      <b>? 全部 $(t_total) 項測試通過，函數行為與第十七章文件一致。</b>
    </p>
  </if>

</card>
</wml>
